# Optional JSON object keyed by sensor_type. Thresholds are intentionally unset by default.
# Example: {"temperature":{"warning":{"max":35},"critical":{"max":45}}}
SENSOR_THRESHOLDS_JSON=

# Optional backend-only credential for a future provider adapter. No provider is configured by default.
AI_API_KEY=

# Exact browser origin permitted to call the demo API.
CORS_ORIGIN=http://localhost:5173

# Demo API port.
PORT=5000
