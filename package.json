{
  "name": "school-reporting",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "predev": "npx kill-port 5173 5001 5174 || exit 0",
    "dev": "concurrently --kill-others --names \"backend,frontend\" \"npm run dev:backend\" \"vite --port 5174 --strictPort false\"",
    "dev:backend": "npm run dev --prefix backend",
    "dev:frontend": "vite --port 5174 --strictPort false",
    "dev:all": "concurrently --kill-others \"npm run dev:backend\" \"vite --port 5174 --strictPort false\"",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "test": "node --test server/*.test.js",
    "preview": "vite preview"
  },
  "dependencies": {
    "@types/qrcode": "^1.5.6",
    "framer-motion": "^13.4.6",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^1.48.0",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "socket.io-client": "^4.8.4"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.13.3",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.6.1",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "kill-port": "^2.0.1",
    "oxlint": "^1.81.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.19",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
